{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "vite build",
    "build:backend": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && esbuild scripts/db-migrate.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/db-migrate.cjs",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:migrate:prod": "node dist/db-migrate.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:unit": "node --import tsx --test \"tests/unit/*.test.ts\"",
    "test:integration": "node --import tsx --test \"tests/integration/*.test.ts\"",
    "test": "npm run test:unit && npm run test:integration",
    "docker:up": "docker-compose up -d",
    "test:docker": "docker-compose -f docker-compose.yml -f docker-compose.test.yml run --build --rm test-runner",
    "smoke:docker": "docker-compose -f docker-compose.yml -f docker-compose.test.yml run --build --rm smoke-runner",
    "validate:docker": "npm run docker:up && npm run test:docker && npm run smoke:docker",
    "smoke:postdeploy": "tsx scripts/smoke-postdeploy.ts",
    "audit:deps": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/pg": "^8.20.0",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "ioredis": "^5.11.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.0",
    "vite": "^6.2.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
