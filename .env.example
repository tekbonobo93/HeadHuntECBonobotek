# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# DATABASE_URL: Required for PostgreSQL-backed application state.
# Example for local Docker Compose:
# postgresql://postgres:postgres@postgres:5432/headhunt
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/headhunt"

# PGSSL: Set to "true" when your PostgreSQL provider requires SSL.
PGSSL="false"

# APP_STATE_USER_ID: Optional singleton state owner id for this demo app.
APP_STATE_USER_ID="default"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# APP_PORT: Local published port for Docker Compose.
# Defaults to 3100 to avoid common collisions with port 3000 on developer machines.
APP_PORT="3100"

# BACKEND_UPSTREAM: Internal URL used by the frontend reverse proxy in Docker.
# In Docker Compose, the default service name is `backend`.
BACKEND_UPSTREAM="http://backend:3000"

# CORS_ALLOWED_ORIGINS: Optional comma-separated origins for a separated frontend.
# Leave empty when frontend and backend are served from the same origin.
CORS_ALLOWED_ORIGINS=""

# INITIAL_ADMIN_EMAIL: First admin bootstrap account.
INITIAL_ADMIN_EMAIL="admin@ejemplo.com"

# Redis-backed auth rate limiting in production.
AUTH_RATE_LIMIT_STRATEGY="redis"
REDIS_URL="redis://redis:6379"

# SMTP provider for verification and password recovery.
SMTP_HOST="smtp.tu-proveedor.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="usuario_smtp"
SMTP_PASS="password_smtp"
SMTP_FROM="TalentoMatch IA <no-reply@tu-dominio.com>"

# AUTH_PREVIEW_LINKS: Set to "true" to expose verification/reset links directly in the UI.
# Useful while no SMTP provider is configured yet.
AUTH_PREVIEW_LINKS="false"
